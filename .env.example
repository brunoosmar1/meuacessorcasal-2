# Copie este arquivo para ".env" e preencha os valores

# Chave da API da Anthropic (https://console.anthropic.com)
# Usada para interpretar as mensagens (texto e imagem) e transformar em lançamentos/lembretes
ANTHROPIC_API_KEY=

# Porta em que o servidor local vai rodar (não usada na Vercel, só localmente)
PORT=3000

# --- Banco de dados (Postgres) ---
# Use um Postgres gerenciado com camada gratuita: Neon (neon.tech), Supabase
# (supabase.com) ou o próprio Vercel Postgres (feito por cima da Neon). Copie a
# "connection string" completa (formato: postgres://usuario:senha@host/banco?sslmode=require)
DATABASE_URL=

# Número (mesmo formato usado no login, ex: 5511999999999) que vira administrador
# automaticamente ao criar a conta e ganha acesso ao painel /admin.html
ADMIN_PHONE=

# --- Cron (lembretes e avisos de conta) ---
# Segredo que protege a rota /api/cron/tick contra chamadas externas indevidas.
# Escolha uma string aleatória qualquer. Configure o mesmo valor no serviço que
# for chamar essa rota (Vercel Cron já envia automaticamente; um scheduler externo
# precisa enviar o header "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta-qualquer
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# --- Google Agenda (OAuth2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Na Vercel, use: https://SEU-PROJETO.vercel.app/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Transcrição de áudio (opcional) ---
TRANSCRIPTION_PROVIDER_URL=

# --- Open Finance / conexão bancária (Pluggy) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
